# Default: let Git normalize text files
* text=auto

# Files that run on Linux must keep LF endings, or the shebang / init breaks
*.sh            text eol=lf
*.py            text eol=lf
*.yaml          text eol=lf
*.cfg           text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
diag-stick/init text eol=lf
diag-stick/udhcpc.script text eol=lf
server-stick/hook/62g53 text eol=lf
server-stick/hook/rootfs/** text eol=lf
server-tools/etc/** text eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf

*.png binary
