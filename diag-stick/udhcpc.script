#!/bin/sh
# Called by busybox udhcpc when the laptop gets, renews or loses a network address.
case "$1" in
    deconfig)
        ip link set "$interface" up
        ;;
    bound|renew)
        ip addr add "$ip/${mask:-24}" dev "$interface" 2>/dev/null
        for r in $router; do
            ip route replace default via "$r" dev "$interface"
            break
        done
        : > /etc/resolv.conf
        for d in $dns; do
            echo "nameserver $d" >> /etc/resolv.conf
        done
        echo "$interface $ip" >> /run/diag/addresses
        ;;
esac
exit 0
